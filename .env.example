NODE_ENV=development
DATABASE_URL=postgresql://bingo:local-demo-only@localhost:5432/bingo
# Supabase deployment uses DATABASE_SCHEMA=bingo; local Compose uses public.
DATABASE_SCHEMA=public
REDIS_URL=redis://localhost:6379
SEED_ENCRYPTION_KEY=GENERATE_WITH_NODE_CRYPTO_32_BYTES_HEX
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
PUBLIC_WEB_URL=http://localhost:3000
SMTP_URL=smtp://localhost:1025
MAIL_FROM=demo@bingo.local
TURNSTILE_BYPASS=true
REAL_MONEY_ENABLED=false
# Production requires TURNSTILE_BYPASS=false plus both Turnstile keys.
# TURNSTILE_SITE_KEY=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET=

# Next.js runtime proxy. Public deployments must override localhost defaults.
API_INTERNAL_URL=http://localhost:4000
# Public HTTPS API URL, used to derive the direct WSS endpoint for browsers.
API_PUBLIC_URL=http://localhost:4000
# See docs/railway.md for the four persistent services and production configuration.
