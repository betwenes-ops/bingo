{
  "name": "@bingo/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "worker": "tsx src/worker.ts",
    "migrate": "tsx src/migrate.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit"
  },
  "dependencies": {
    "@bingo/domain": "workspace:*",
    "@bingo/protocol": "workspace:*",
    "fastify": "5.12.7",
    "@fastify/cookie": "11.1.3",
    "@fastify/cors": "11.3.1",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/websocket": "11.3.4",
    "@fastify/swagger": "9.9.2",
    "fastify-type-provider-zod": "7.0.0",
    "zod": "4.6.7",
    "pg": "8.23.1",
    "drizzle-orm": "0.45.4",
    "argon2": "0.45.1",
    "nodemailer": "10.1.1",
    "ioredis": "6.0.0",
    "tsx": "4.23.15",
    "ws": "8.22.0",
    "prom-client": "15.1.3",
    "@bingo/bingo-math": "workspace:*"
  },
  "devDependencies": {
